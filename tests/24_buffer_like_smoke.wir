(core-module
  (core-version 1)

  (decls

    (extern malloc
      (params
        (size i64))
      (returns ptr))

    (extern free
      (params
        (p ptr))
      (returns void))

    (fn main
      (params)
      (returns i32)

      (body
        ; Allocate fake Buffer object: data ptr, length i64, capacity i64.
        (let buffer ptr
          (call_ptr malloc
            (const_i64 24)))

        (if
          (eq_ptr
            (local_get buffer)
            (const_null))

          (then
            (return
              (const_i32 0)))

          (else
            (block)))

        (let data ptr
          (call_ptr malloc
            (const_i64 8)))

        (if
          (eq_ptr
            (local_get data)
            (const_null))

          (then
            (block
              (call_void free
                (local_get buffer))

              (return
                (const_i32 0))))

          (else
            (block)))

        ; buffer.data = data
        (store_ptr
          (local_get buffer)
          (local_get data))

        ; buffer.length = 1
        (store_i64
          (ptr_add
            (local_get buffer)
            (const_i64 8))
          (const_i64 1))

        ; buffer.capacity = 8
        (store_i64
          (ptr_add
            (local_get buffer)
            (const_i64 16))
          (const_i64 8))

        ; data[0] = 42
        (store_i8
          (local_get data)
          (const_i32 42))

        (let data2 ptr
          (load_ptr
            (local_get buffer)))

        (let x i32
          (load_u8
            (local_get data2)))

        (call_void free
          (local_get data))

        (call_void free
          (local_get buffer))

        (return
          (local_get x))))))
