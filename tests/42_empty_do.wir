; 42_empty_do.wir
; purpose: ensures empty do blocks are accepted and emitted safely.
; verifies parser and codegen do not require non-empty statement lists.
; expected runtime behavior: process exits with code 42.

(core-module
  (core-version 1)
  (decls
    (fn main
      (params)
      (returns i32)
      (do
        (if
          (condition
            (eq_i32
              (const_i32 1)
              (const_i32 2)
            ) ;; eq_i32
          ) ;; condition
          (then
            (do)
          ) ;; then
          (else
            (do)
          ) ;; else
        ) ;; if

        (return
          (const_i32 42)
        ) ;; return
      ) ;; do
    ) ;; fn
  ) ;; decls
) ;; core-module
