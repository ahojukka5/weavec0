; 35_sub_i32.wir
; purpose: adds direct i32 subtraction operator coverage.
; verifies sub_i32 parsing and arithmetic lowering path.
; expected runtime behavior: process exits with code 42.

(core-module
  (core-version 1)
  (decls
    (fn main
      (params)
      (returns i32)
      (do
        (return
          (sub_i32
            (const_i32 50)
            (const_i32 8)
          ) ;; sub_i32
        ) ;; return
      ) ;; do
    ) ;; fn
  ) ;; decls
) ;; core-module
