; 10_string_literal.wir
; purpose: checks string literal tokenization and emission path.
; verifies const_string handling with runtime print interaction.
; expected runtime behavior: process exits with code 42.

(core-module
  (core-version 1)
  (decls
    (fn main
      (params)
      (returns i32)
      (do
        (print
          (const_string "hello from weave")
        ) ;; print
        (return
          (const_i32 42)
        ) ;; return
      ) ;; do
    ) ;; fn
  ) ;; decls
) ;; core-module
