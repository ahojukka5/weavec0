; 49_negative_i32_literal.wir
; purpose: checks parsing and lowering of negative i32 literals.
; verifies signed literal handling without rewriting semantics.
; expected runtime behavior: process exits with code 42.

(core-module
  (core-version 1)
  (decls
    (fn main
      (params)
      (returns i32)
      (do
        (return
          (add_i32
            (const_i32 -8)
            (const_i32 50)
          ) ;; add_i32
        ) ;; return
      ) ;; do
    ) ;; fn
  ) ;; decls
) ;; core-module
