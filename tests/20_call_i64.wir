; 20_call_i64.wir
; purpose: validates call sites for i64-returning functions.
; verifies i64 call result propagation into later computation/return.
; expected runtime behavior: process exits with code 42.

(core-module
  (core-version 1)
  (decls
    (fn answer64
      (params)
      (returns i64)
      (do
        (return
          (const_i64 42)
        ) ;; return
      ) ;; do
    ) ;; fn
    (fn main
      (params)
      (returns i32)
      (do
        (return
          (cast_i64_to_i32
            (call_i64 answer64)
          ) ;; cast_i64_to_i32
        ) ;; return
      ) ;; do
    ) ;; fn
  ) ;; decls
) ;; core-module
