; 22_return_void.wir
; purpose: checks explicit return_void statement handling.
; verifies void functions terminate cleanly in emitted LLVM IR.
; expected runtime behavior: process exits with code 42.

(core-module
  (core-version 1)
  (decls
    (fn noop
      (params)
      (returns void)
      (do
        (return_void)
      ) ;; do
    ) ;; fn
    (fn main
      (params)
      (returns i32)
      (do
        (call_void noop)
        (return
          (const_i32 42)
        ) ;; return
      ) ;; do
    ) ;; fn
  ) ;; decls
) ;; core-module
