; 34_ge_i32.wir
; purpose: validates signed greater-or-equal comparison for i32.
; verifies ge_i32 emits the expected icmp sge behavior.
; expected runtime behavior: process exits with code 42.

(core-module
  (core-version 1)
  (decls
    (fn main
      (params)
      (returns i32)
      (do
        (if
          (condition
            (ge_i32
              (const_i32 42)
              (const_i32 42)
            ) ;; ge_i32
          ) ;; condition
          (then
            (do
              (return
                (const_i32 42)
              ) ;; return
            ) ;; do
          ) ;; then
          (else
            (do
              (return
                (const_i32 0)
              ) ;; return
            ) ;; do
          ) ;; else
        ) ;; if
      ) ;; do
    ) ;; fn
  ) ;; decls
) ;; core-module
