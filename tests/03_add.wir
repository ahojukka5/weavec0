; 03_add.wir
; purpose: checks arithmetic expression lowering for add_i32.
; verifies integer addition result is returned from main.
; expected runtime behavior: process exits with code 42.

(core-module
  (core-version 1)
  (decls
    (fn main
      (params)
      (returns i32)
      (do
        (return
          (add_i32
            (const_i32 20)
            (const_i32 22)
          ) ;; add_i32
        ) ;; return
      ) ;; do
    ) ;; fn
  ) ;; decls
) ;; core-module
