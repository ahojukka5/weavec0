(core-module
  (core-version 1)

  (decls

    (extern malloc
      (params
        (size i64))
      (returns ptr))

    (extern free
      (params
        (p ptr))
      (returns void))

    (fn main
      (params)
      (returns i32)

      (body
        (let p ptr
          (call_ptr malloc
            (const_i64 1)))

        (if
          (eq_ptr
            (local_get p)
            (const_null))

          (then
            (return
              (const_i32 0)))

          (else
            (block)))

        (store_i8
          (local_get p)
          (const_i32 42))

        (let x i32
          (load_u8
            (local_get p)))

        (call_void free
          (local_get p))

        (return
          (local_get x))))))
