; 05_let_local.wir
; purpose: exercises local variable introduction with let.
; verifies local allocation, initialization, and readback via local_get.
; expected runtime behavior: process exits with code 42.

(core-module
  (core-version 1)
  (decls
    (fn main
      (params)
      (returns i32)
      (do
        (let x i32
          (const_i32 40)
        ) ;; let
        (return
          (add_i32
            (local_get x)
            (const_i32 2)
          ) ;; add_i32
        ) ;; return
      ) ;; do
    ) ;; fn
  ) ;; decls
) ;; core-module
