; 53_wrong_arity_add_i32_too_many.wir
; purpose: validates arity checking for add_i32 with extra arguments.
; verifies parser rejects too-many-argument calls with a clear error.
; expected compiler behavior: compilation fails with an arity diagnostic.

(core-module
  (core-version 1)
  (decls
    (fn main
      (params)
      (returns i32)
      (do
        (return
          (add_i32
            (const_i32 10)
            (const_i32 20)
            (const_i32 12)
          ) ;; add_i32
        ) ;; return
      ) ;; do
    ) ;; fn
  ) ;; decls
) ;; core-module
