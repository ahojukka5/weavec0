  %is_ptr = icmp eq i32 %type_kind, 58
  br i1 %is_ptr, label %select_ptr, label %check_i64

check_i64:
  %is_i64 = icmp eq i32 %type_kind, 39
  br i1 %is_i64, label %select_i64, label %check_bool

check_bool:
