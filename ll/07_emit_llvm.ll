; ----------------------------------------------------------------------------
; Counter helpers
; ----------------------------------------------------------------------------

define i64 @weave_emit_next_temp(ptr %ctx) {
entry:
  %field = call ptr @weave_emit_temp_counter_ptr(ptr %ctx)
  %old = load i64, ptr %field
  %next = add i64 %old, 1
  store i64 %next, ptr %field
  ret i64 %old
}

define i64 @weave_emit_next_label(ptr %ctx) {
entry:
  %field = call ptr @weave_emit_label_counter_ptr(ptr %ctx)
  %old = load i64, ptr %field
  %next = add i64 %old, 1
  store i64 %next, ptr %field
  ret i64 %old
}

; ----------------------------------------------------------------------------
; Source slice emission
; ----------------------------------------------------------------------------
;
; Append source bytes [start, start + length) to the output.
;
; Used for function names and call names. Stage 0 assumes trusted bootstrap
; source and does not yet sanitize identifiers.


define i32 @weave_emit_source_slice(ptr %ctx, i64 %start, i64 %length) {
entry:
  %source = call ptr @weave_emit_source(ptr %ctx)
  %data = call ptr @weave_source_data(ptr %source)
  %slice = getelementptr inbounds i8, ptr %data, i64 %start
  %out = call ptr @weave_emit_out(ptr %ctx)
  %status = call i32 @weave_buffer_append_bytes(ptr %out, ptr %slice, i64 %length)
  ret i32 %status
}

; ----------------------------------------------------------------------------
; Local type lookup
; ----------------------------------------------------------------------------

define i32 @weave_emit_lookup_local_type(ptr %ctx, i64 %name_start, i64 %name_len) {
entry:
  %ast = call ptr @weave_emit_ast(ptr %ctx)
  %count = call i64 @weave_ast_count(ptr %ast)
  br label %loop

loop:
  %i = phi i64 [0, %entry], [%next_i, %after_node]
  %found = phi i32 [32, %entry], [%found_next, %after_node]
  %done = icmp uge i64 %i, %count
  br i1 %done, label %success, label %check_node

check_node:
  %kind = call i32 @weave_ast_kind(ptr %ast, i64 %i)
  %is_let = icmp eq i32 %kind, 7
  br i1 %is_let, label %check_name, label %after_node

check_name:
  %let_name_start = call i64 @weave_ast_text_start(ptr %ast, i64 %i)
  %let_name_len = call i64 @weave_ast_text_len(ptr %ast, i64 %i)
  %source = call ptr @weave_emit_source(ptr %ctx)
  %data = call ptr @weave_source_data(ptr %source)
  %name_text = getelementptr inbounds i8, ptr %data, i64 %name_start
  %let_text = getelementptr inbounds i8, ptr %data, i64 %let_name_start
  %matches = call i32 @weave_bytes_equal(
    ptr %name_text,
    i64 %name_len,
    ptr %let_text,
    i64 %let_name_len
  )
  %is_match = icmp ne i32 %matches, 0
  br i1 %is_match, label %record, label %after_node

record:
  %let_type_wide = call i64 @weave_ast_b(ptr %ast, i64 %i)
  %let_type = trunc i64 %let_type_wide to i32
  br label %after_node

after_node:
  %found_next = phi i32 [ %found, %check_node ], [ %found, %check_name ], [ %let_type, %record ]
  %next_i = add i64 %i, 1
  br label %loop

success:
  ret i32 %found
}

; ----------------------------------------------------------------------------
; Value representation
; ----------------------------------------------------------------------------
;
; Expressions return a compact emitted-value descriptor:
;
;   >= 0 : temporary id %tN
;   <  0 : immediate i32 value encoded as -(value + 1)
;
; This lets Stage 0 avoid a richer value object while still emitting readable IR.
;
; Note: this encoding is primitive and only intended for small bootstrap tests.


define i64 @weave_emit_immediate_value(i32 %value) {
entry:
  %wide = sext i32 %value to i64
  %plus_one = add i64 %wide, 1
  %encoded = sub i64 0, %plus_one
  ret i64 %encoded
}

define i64 @weave_emit_null_value() {
entry:
  ret i64 -9223372036854775807
}

define i64 @weave_emit_void_value() {
entry:
  ret i64 -9223372036854775806
}

define i32 @weave_emitted_value_is_null(i64 %value) {
entry:
  %is_null = icmp eq i64 %value, -9223372036854775807
  br i1 %is_null, label %yes, label %no

yes:
  ret i32 1

no:
  ret i32 0
}

define i32 @weave_emitted_value_is_temp(i64 %value) {
entry:
  %is_temp = icmp sge i64 %value, 0
  br i1 %is_temp, label %yes, label %no

yes:
  ret i32 1

no:
  ret i32 0
}

define i32 @weave_emitted_value_immediate_i32(i64 %value) {
entry:
  %neg = sub i64 0, %value
  %minus_one = sub i64 %neg, 1
  %narrow = trunc i64 %minus_one to i32
  ret i32 %narrow
}

; ----------------------------------------------------------------------------
; Emit an i32 operand.
; ----------------------------------------------------------------------------
;
; Operand may be either an immediate value or a temp id.


define i32 @weave_emit_operand(ptr %ctx, i64 %value) {
entry:
  %is_null_i32 = call i32 @weave_emitted_value_is_null(i64 %value)
  %is_null = icmp ne i32 %is_null_i32, 0
  br i1 %is_null, label %null, label %check_temp

check_temp:
  %is_temp_i32 = call i32 @weave_emitted_value_is_temp(i64 %value)
  %is_temp = icmp ne i32 %is_temp_i32, 0
  br i1 %is_temp, label %temp, label %immediate

null:
  %s_null = call i32 @weave_emit_cstr(ptr %ctx, ptr @weave.emit.null)
  %null_failed = icmp ne i32 %s_null, 0
  br i1 %null_failed, label %fail, label %success

temp:
  %s0 = call i32 @weave_emit_cstr(ptr %ctx, ptr @weave.emit.tmp_prefix)
  %temp_i32 = trunc i64 %value to i32
  %s1 = call i32 @weave_emit_i32(ptr %ctx, i32 %temp_i32)
  %s0_failed = icmp ne i32 %s0, 0
  %s1_failed = icmp ne i32 %s1, 0
  %bad0 = or i1 %s0_failed, %s1_failed
  br i1 %bad0, label %fail, label %success

immediate:
  %imm = call i32 @weave_emitted_value_immediate_i32(i64 %value)
  %s2 = call i32 @weave_emit_i32(ptr %ctx, i32 %imm)
  %bad1 = icmp ne i32 %s2, 0
  br i1 %bad1, label %fail, label %success

success:
  ret i32 0

fail:
  ret i32 1
}

; ----------------------------------------------------------------------------
; Emit an expression as an instruction operand.
; ----------------------------------------------------------------------------

define i32 @weave_emit_expr_operand(ptr %ctx, i64 %node_index) {
entry:
  %emitted = call i64 @weave_emit_expr(ptr %ctx, i64 %node_index)
  %failed = icmp eq i64 %emitted, -9223372036854775808
  br i1 %failed, label %fail, label %emit_operand

emit_operand:
  %status = call i32 @weave_emit_operand(ptr %ctx, i64 %emitted)
  %operand_failed = icmp ne i32 %status, 0
  br i1 %operand_failed, label %fail, label %success

success:
  ret i32 0

fail:
  ret i32 1
}

; ----------------------------------------------------------------------------
; Emit binary expression
; ----------------------------------------------------------------------------


define i64 @weave_emit_binary_expr(ptr %ctx, i64 %node_index) {
entry:
  %ast = call ptr @weave_emit_ast(ptr %ctx)
  %op_wide = call i64 @weave_ast_a(ptr %ast, i64 %node_index)
  %lhs_node = call i64 @weave_ast_b(ptr %ast, i64 %node_index)
  %rhs_node = call i64 @weave_ast_c(ptr %ast, i64 %node_index)

  %lhs_value = call i64 @weave_emit_expr(ptr %ctx, i64 %lhs_node)
  %lhs_failed = icmp eq i64 %lhs_value, -9223372036854775808
  br i1 %lhs_failed, label %fail, label %rhs

rhs:
  %rhs_value = call i64 @weave_emit_expr(ptr %ctx, i64 %rhs_node)
  %rhs_failed = icmp eq i64 %rhs_value, -9223372036854775808
  br i1 %rhs_failed, label %fail, label %emit

emit:
  %temp = call i64 @weave_emit_next_temp(ptr %ctx)
  %s0 = call i32 @weave_emit_cstr(ptr %ctx, ptr @weave.emit.tmp_prefix)
  %temp_i32 = trunc i64 %temp to i32
  %s1 = call i32 @weave_emit_i32(ptr %ctx, i32 %temp_i32)

  %op = trunc i64 %op_wide to i32
  %op_text_status = call i32 @weave_emit_binary_op_text(ptr %ctx, i32 %op)

  %s2 = call i32 @weave_emit_operand(ptr %ctx, i64 %lhs_value)

  %is_cmp_op = icmp sge i32 %op, 5
  br i1 %is_cmp_op, label %emit_cmp_rhs, label %emit_i32_rhs

emit_i32_rhs:
  %s3 = call i32 @weave_emit_cstr(ptr %ctx, ptr @weave.emit.comma_i32)
  %s4 = call i32 @weave_emit_operand(ptr %ctx, i64 %rhs_value)
  %s5 = call i32 @weave_emit_newline(ptr %ctx)
  %s3_failed = icmp ne i32 %s3, 0
  %s4_failed = icmp ne i32 %s4, 0
  %s5_failed = icmp ne i32 %s5, 0
  %i32_tail_bad0 = or i1 %s3_failed, %s4_failed
  %i32_tail_bad = or i1 %i32_tail_bad0, %s5_failed
  br label %check_status

emit_cmp_rhs:
  %s6 = call i32 @weave_emit_cstr(ptr %ctx, ptr @weave.emit.comma_i32)
  %s7 = call i32 @weave_emit_operand(ptr %ctx, i64 %rhs_value)
  %s8 = call i32 @weave_emit_newline(ptr %ctx)
  %s6_failed = icmp ne i32 %s6, 0
  %s7_failed = icmp ne i32 %s7, 0
  %s8_failed = icmp ne i32 %s8, 0
  %cmp_tail_bad0 = or i1 %s6_failed, %s7_failed
  %cmp_tail_bad = or i1 %cmp_tail_bad0, %s8_failed
  br label %check_status

check_status:
  %tail_bad = phi i1 [%i32_tail_bad, %emit_i32_rhs], [%cmp_tail_bad, %emit_cmp_rhs]
  %head_s0_failed = icmp ne i32 %s0, 0
  %head_s1_failed = icmp ne i32 %s1, 0
  %op_text_failed = icmp ne i32 %op_text_status, 0
  %s2_failed = icmp ne i32 %s2, 0
  %head_bad1 = or i1 %head_s0_failed, %head_s1_failed
  %head_bad2 = or i1 %op_text_failed, %s2_failed
  %head_bad = or i1 %head_bad1, %head_bad2
  %bad = or i1 %head_bad, %tail_bad
  br i1 %bad, label %fail, label %success

success:
  ret i64 %temp

fail:
  ret i64 -9223372036854775808
}

; ----------------------------------------------------------------------------
; weave_emit_binary_op_text
; ----------------------------------------------------------------------------

define i32 @weave_emit_binary_op_text(ptr %ctx, i32 %op) {
entry:
  %is_add = icmp eq i32 %op, 1
  br i1 %is_add, label %add, label %check_lt

check_lt:
  %is_lt = icmp eq i32 %op, 7
  br i1 %is_lt, label %lt, label %check_add_i64

add:
  %s_add = call i32 @weave_emit_cstr(ptr %ctx, ptr @weave.emit.add)
