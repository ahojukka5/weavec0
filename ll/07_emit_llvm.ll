  %failed_raw = icmp eq i64 %value_raw, -9223372036854775808
  br i1 %failed_raw, label %fail, label %success

success:
  ret i32 0

fail:
  ret i32 1
}

; ----------------------------------------------------------------------------
; weave_emit_function
; ----------------------------------------------------------------------------

define i32 @weave_emit_function(ptr %ctx, i64 %node_index) {
entry:
  %ast = call ptr @weave_emit_ast(ptr %ctx)
  %body_node = call i64 @weave_ast_a(ptr %ast, i64 %node_index)
  %param_start = call i64 @weave_ast_b(ptr %ast, i64 %node_index)
  %param_len = call i64 @weave_ast_c(ptr %ast, i64 %node_index)
  %param2_start = call i64 @weave_ast_text_start(ptr %ast, i64 %body_node)
  %param2_len = call i64 @weave_ast_text_len(ptr %ast, i64 %body_node)
  %return_type_wide = call i64 @weave_ast_c(ptr %ast, i64 %body_node)
  %return_type = trunc i64 %return_type_wide to i32
  %returns_i64 = icmp eq i32 %return_type, 39
  %returns_ptr = icmp eq i32 %return_type, 58
  %returns_void = icmp eq i32 %return_type, 59
  %name_start = call i64 @weave_ast_text_start(ptr %ast, i64 %node_index)
  %name_len = call i64 @weave_ast_text_len(ptr %ast, i64 %node_index)

  br i1 %returns_i64, label %emit_i64_define, label %check_ptr_define

check_ptr_define:
  br i1 %returns_ptr, label %emit_ptr_define, label %check_void_define

check_void_define:
  br i1 %returns_void, label %emit_void_define, label %emit_i32_define

emit_i32_define:
  %s0_i32 = call i32 @weave_emit_cstr(ptr %ctx, ptr @weave.emit.define_i32)
  br label %emit_name

emit_i64_define:
  %s0_i64 = call i32 @weave_emit_cstr(ptr %ctx, ptr @weave.emit.define_i64)
  br label %emit_name

emit_ptr_define:
  %s0_ptr = call i32 @weave_emit_cstr(ptr %ctx, ptr @weave.emit.define_ptr)
  br label %emit_name

emit_void_define:
  %s0_void = call i32 @weave_emit_cstr(ptr %ctx, ptr @weave.emit.define_void)
  br label %emit_name

emit_name:
  %s0 = phi i32 [%s0_i32, %emit_i32_define], [%s0_i64, %emit_i64_define], [%s0_ptr, %emit_ptr_define], [%s0_void, %emit_void_define]
  %s1 = call i32 @weave_emit_source_slice(ptr %ctx, i64 %name_start, i64 %name_len)
  %has_param = icmp ne i64 %param_len, 0
  %has_param2 = icmp ne i64 %param2_len, 0
  br i1 %has_param, label %emit_param_sig, label %emit_no_param_sig

emit_no_param_sig:
  %s2_no_param = call i32 @weave_emit_cstr(ptr %ctx, ptr @weave.emit.fn_sig)
  br label %emit_entry

emit_param_sig:
  %s2_param_a = call i32 @weave_emit_cstr(ptr %ctx, ptr @weave.emit.fn_sig_1_prefix)
  %s2_param_b = call i32 @weave_emit_source_slice(ptr %ctx, i64 %param_start, i64 %param_len)
  br i1 %has_param2, label %emit_param2_sig, label %emit_param1_sig_end

emit_param2_sig:
  %s2_param_mid = call i32 @weave_emit_cstr(ptr %ctx, ptr @weave.emit.fn_sig_2_mid)
  %s2_param_d = call i32 @weave_emit_source_slice(ptr %ctx, i64 %param2_start, i64 %param2_len)
  br label %emit_param1_sig_end

emit_param1_sig_end:
  %s2_param_extra = phi i32 [0, %emit_param_sig], [%s2_param_mid, %emit_param2_sig]
  %s2_param_extra2 = phi i32 [0, %emit_param_sig], [%s2_param_d, %emit_param2_sig]
  %s2_param_c = call i32 @weave_emit_cstr(ptr %ctx, ptr @weave.emit.fn_sig_1_suffix)
  %s2_param_a_failed = icmp ne i32 %s2_param_a, 0
  %s2_param_b_failed = icmp ne i32 %s2_param_b, 0
  %s2_param_extra_failed = icmp ne i32 %s2_param_extra, 0
  %s2_param_extra2_failed = icmp ne i32 %s2_param_extra2, 0
  %s2_param_c_failed = icmp ne i32 %s2_param_c, 0
  %s2_param_bad0 = or i1 %s2_param_a_failed, %s2_param_b_failed
  %s2_param_bad1 = or i1 %s2_param_extra_failed, %s2_param_extra2_failed
  %s2_param_bad2 = or i1 %s2_param_bad0, %s2_param_bad1
  %s2_param_bad = or i1 %s2_param_bad2, %s2_param_c_failed
  br label %emit_entry

emit_entry:
  %s2 = phi i32 [%s2_no_param, %emit_no_param_sig], [0, %emit_param1_sig_end]
  %s2_param_failed = phi i1 [false, %emit_no_param_sig], [%s2_param_bad, %emit_param1_sig_end]
  %s3 = call i32 @weave_emit_cstr(ptr %ctx, ptr @weave.emit.entry)

  %s0_failed = icmp ne i32 %s0, 0
  %s1_failed = icmp ne i32 %s1, 0
  %s2_failed = icmp ne i32 %s2, 0
  %s3_failed = icmp ne i32 %s3, 0
  %head_bad0 = or i1 %s0_failed, %s1_failed
  %head_bad1 = or i1 %s2_failed, %s3_failed
  %head_bad2 = or i1 %head_bad1, %s2_param_failed
  %head_bad = or i1 %head_bad0, %head_bad2
  br i1 %head_bad, label %fail, label %maybe_init_param

maybe_init_param:
  br i1 %has_param, label %init_param, label %body

init_param:
  %p0 = call i32 @weave_emit_cstr(ptr %ctx, ptr @weave.emit.percent)
  %p1 = call i32 @weave_emit_source_slice(ptr %ctx, i64 %param_start, i64 %param_len)
  %p2 = call i32 @weave_emit_cstr(ptr %ctx, ptr @weave.emit.alloca_i32)
  %p3 = call i32 @weave_emit_cstr(ptr %ctx, ptr @weave.emit.store_i32)
  %p4 = call i32 @weave_emit_cstr(ptr %ctx, ptr @weave.emit.percent)
  %p5 = call i32 @weave_emit_source_slice(ptr %ctx, i64 %param_start, i64 %param_len)
  %p6 = call i32 @weave_emit_cstr(ptr %ctx, ptr @weave.emit.arg_suffix)
  %p7 = call i32 @weave_emit_cstr(ptr %ctx, ptr @weave.emit.comma_ptr_percent)
  %p8 = call i32 @weave_emit_source_slice(ptr %ctx, i64 %param_start, i64 %param_len)
  %p9 = call i32 @weave_emit_newline(ptr %ctx)
  %p0_failed = icmp ne i32 %p0, 0
  %p1_failed = icmp ne i32 %p1, 0
  %p2_failed = icmp ne i32 %p2, 0
  %p3_failed = icmp ne i32 %p3, 0
  %p4_failed = icmp ne i32 %p4, 0
  %p5_failed = icmp ne i32 %p5, 0
  %p6_failed = icmp ne i32 %p6, 0
  %p7_failed = icmp ne i32 %p7, 0
  %p8_failed = icmp ne i32 %p8, 0
  %p9_failed = icmp ne i32 %p9, 0
  %p_bad01 = or i1 %p0_failed, %p1_failed
  %p_bad23 = or i1 %p2_failed, %p3_failed
  %p_bad45 = or i1 %p4_failed, %p5_failed
  %p_bad67 = or i1 %p6_failed, %p7_failed
  %p_bad89 = or i1 %p8_failed, %p9_failed
  %p_bad0123 = or i1 %p_bad01, %p_bad23
  %p_bad4567 = or i1 %p_bad45, %p_bad67
  %p_bad01234567 = or i1 %p_bad0123, %p_bad4567
  %p_bad = or i1 %p_bad01234567, %p_bad89
  br i1 %p_bad, label %fail, label %maybe_init_param2

maybe_init_param2:
  br i1 %has_param2, label %init_param2, label %body

init_param2:
  %q0 = call i32 @weave_emit_cstr(ptr %ctx, ptr @weave.emit.percent)
  %q1 = call i32 @weave_emit_source_slice(ptr %ctx, i64 %param2_start, i64 %param2_len)
  %q2 = call i32 @weave_emit_cstr(ptr %ctx, ptr @weave.emit.alloca_i32)
  %q3 = call i32 @weave_emit_cstr(ptr %ctx, ptr @weave.emit.store_i32)
  %q4 = call i32 @weave_emit_cstr(ptr %ctx, ptr @weave.emit.percent)
  %q5 = call i32 @weave_emit_source_slice(ptr %ctx, i64 %param2_start, i64 %param2_len)
  %q6 = call i32 @weave_emit_cstr(ptr %ctx, ptr @weave.emit.arg_suffix)
  %q7 = call i32 @weave_emit_cstr(ptr %ctx, ptr @weave.emit.comma_ptr_percent)
  %q8 = call i32 @weave_emit_source_slice(ptr %ctx, i64 %param2_start, i64 %param2_len)
  %q9 = call i32 @weave_emit_newline(ptr %ctx)
  %q0_failed = icmp ne i32 %q0, 0
  %q1_failed = icmp ne i32 %q1, 0
  %q2_failed = icmp ne i32 %q2, 0
  %q3_failed = icmp ne i32 %q3, 0
  %q4_failed = icmp ne i32 %q4, 0
  %q5_failed = icmp ne i32 %q5, 0
  %q6_failed = icmp ne i32 %q6, 0
  %q7_failed = icmp ne i32 %q7, 0
  %q8_failed = icmp ne i32 %q8, 0
  %q9_failed = icmp ne i32 %q9, 0
  %q_bad01 = or i1 %q0_failed, %q1_failed
  %q_bad23 = or i1 %q2_failed, %q3_failed
  %q_bad45 = or i1 %q4_failed, %q5_failed
  %q_bad67 = or i1 %q6_failed, %q7_failed
  %q_bad89 = or i1 %q8_failed, %q9_failed
  %q_bad0123 = or i1 %q_bad01, %q_bad23
  %q_bad4567 = or i1 %q_bad45, %q_bad67
  %q_bad01234567 = or i1 %q_bad0123, %q_bad4567
  %q_bad = or i1 %q_bad01234567, %q_bad89
  br i1 %q_bad, label %fail, label %body

body:
  call void @weave_emit_set_return_type(ptr %ctx, i32 %return_type)
  %body_status = call i32 @weave_emit_stmt(ptr %ctx, i64 %body_node)
  %body_failed = icmp ne i32 %body_status, 0
  br i1 %body_failed, label %fail, label %close

close:
  %s4 = call i32 @weave_emit_cstr(ptr %ctx, ptr @weave.emit.close_fn)
  %close_failed = icmp ne i32 %s4, 0
  br i1 %close_failed, label %fail, label %success

success:
  ret i32 0

fail:
  ret i32 1
}

; ----------------------------------------------------------------------------
; weave_emit_program
; ----------------------------------------------------------------------------
;
; Stage 0 scans the compact AST and emits nodes whose kind is AST_FUNCTION.
; Function nodes are not contiguous because each function body is parsed before
; the function wrapper node is appended.


define i32 @weave_emit_program(ptr %ctx, i64 %program_node) {
entry:
  %ast = call ptr @weave_emit_ast(ptr %ctx)
  %node_count = call i64 @weave_ast_count(ptr %ast)

  %header_status = call i32 @weave_emit_cstr(ptr %ctx, ptr @weave.emit.module_header)
  %header_failed = icmp ne i32 %header_status, 0
  br i1 %header_failed, label %fail, label %emit_strings

emit_strings:
  %strings_status = call i32 @weave_emit_string_globals(ptr %ctx)
  %strings_failed = icmp ne i32 %strings_status, 0
  br i1 %strings_failed, label %fail, label %loop

loop:
  %i = phi i64 [0, %emit_strings], [%next_i, %after_node]
  %done = icmp uge i64 %i, %node_count
  br i1 %done, label %success, label %check_node

check_node:
  %kind = call i32 @weave_ast_kind(ptr %ast, i64 %i)
  %is_function = icmp eq i32 %kind, 2
  br i1 %is_function, label %emit_function, label %after_node

emit_function:
  %status = call i32 @weave_emit_function(ptr %ctx, i64 %i)
  %failed = icmp ne i32 %status, 0
  br i1 %failed, label %fail, label %after_node

after_node:
  %next_i = add i64 %i, 1
  br label %loop

success:
  ret i32 0

fail:
  ret i32 1
}

; ----------------------------------------------------------------------------
; weave_emit_llvm
;
; Public emitter entry point.
;
; Returns:
;   0 on success
;   1 on failure
; ----------------------------------------------------------------------------

define i32 @weave_emit_llvm(ptr %source, ptr %ast, i64 %program_node, ptr %out) {
entry:
  %ctx_storage = alloca %weave.EmitContext
  call void @weave_emit_context_init(ptr %ctx_storage, ptr %source, ptr %ast, ptr %out)
  %status = call i32 @weave_emit_program(ptr %ctx_storage, i64 %program_node)
  ret i32 %status
}
