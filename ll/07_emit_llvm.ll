; =============================================================================
; Weave Stage 0 Bootstrap Compiler
; 07_emit_llvm.ll
;
; Minimal LLVM IR emitter for the Stage 0 bootstrap subset.
;
; Responsibility:
;
;     AST -> LLVM IR text
;
; The emitter intentionally targets only small i32 programs. It is not an
; optimizer, verifier, type checker, or production backend.
; =============================================================================

; ----------------------------------------------------------------------------
; Emit context
; ----------------------------------------------------------------------------
;
; Stage 0 keeps the emitter state deliberately small.
;
; %weave.EmitContext = type {
;   ptr, ; source : %weave.Source*
;   ptr, ; ast    : %weave.Ast*
;   ptr, ; out    : %weave.Buffer*
;   i64, ; temp counter
;   i64, ; label counter
;   i32  ; current function return type token kind
; }

%weave.EmitContext = type { ptr, ptr, ptr, i64, i64, i32 }

; ----------------------------------------------------------------------------
; Emit context accessors
; ----------------------------------------------------------------------------

define ptr @weave_emit_source_ptr(ptr %ctx) {
entry:
  %field = getelementptr inbounds %weave.EmitContext, ptr %ctx, i32 0, i32 0
  ret ptr %field
}

define ptr @weave_emit_ast_ptr(ptr %ctx) {
entry:
  %field = getelementptr inbounds %weave.EmitContext, ptr %ctx, i32 0, i32 1
  ret ptr %field
}

define ptr @weave_emit_out_ptr(ptr %ctx) {
entry:
  %field = getelementptr inbounds %weave.EmitContext, ptr %ctx, i32 0, i32 2
  ret ptr %field
}

define ptr @weave_emit_temp_counter_ptr(ptr %ctx) {
entry:
  %field = getelementptr inbounds %weave.EmitContext, ptr %ctx, i32 0, i32 3
  ret ptr %field
}

define ptr @weave_emit_label_counter_ptr(ptr %ctx) {
entry:
  %field = getelementptr inbounds %weave.EmitContext, ptr %ctx, i32 0, i32 4
  ret ptr %field
}

define ptr @weave_emit_return_type_ptr(ptr %ctx) {
entry:
  %field = getelementptr inbounds %weave.EmitContext, ptr %ctx, i32 0, i32 5
  ret ptr %field
}

define ptr @weave_emit_source(ptr %ctx) {
entry:
  %field = call ptr @weave_emit_source_ptr(ptr %ctx)
  %value = load ptr, ptr %field
  ret ptr %value
}

define ptr @weave_emit_ast(ptr %ctx) {
entry:
  %field = call ptr @weave_emit_ast_ptr(ptr %ctx)
  %value = load ptr, ptr %field
  ret ptr %value
}

define ptr @weave_emit_out(ptr %ctx) {
entry:
  %field = call ptr @weave_emit_out_ptr(ptr %ctx)
  %value = load ptr, ptr %field
  ret ptr %value
}

define i32 @weave_emit_return_type(ptr %ctx) {
entry:
  %field = call ptr @weave_emit_return_type_ptr(ptr %ctx)
  %value = load i32, ptr %field
  ret i32 %value
}

define void @weave_emit_set_return_type(ptr %ctx, i32 %return_type) {
entry:
  %field = call ptr @weave_emit_return_type_ptr(ptr %ctx)
  store i32 %return_type, ptr %field
  ret void
}

; ----------------------------------------------------------------------------
; weave_emit_context_init
; ----------------------------------------------------------------------------

define void @weave_emit_context_init(ptr %ctx, ptr %source, ptr %ast, ptr %out) {
entry:
  %source_field = call ptr @weave_emit_source_ptr(ptr %ctx)
  %ast_field = call ptr @weave_emit_ast_ptr(ptr %ctx)
  %out_field = call ptr @weave_emit_out_ptr(ptr %ctx)
  %temp_field = call ptr @weave_emit_temp_counter_ptr(ptr %ctx)
  %label_field = call ptr @weave_emit_label_counter_ptr(ptr %ctx)
  %return_type_field = call ptr @weave_emit_return_type_ptr(ptr %ctx)

  store ptr %source, ptr %source_field
  store ptr %ast, ptr %ast_field
  store ptr %out, ptr %out_field
  store i64 0, ptr %temp_field
  store i64 0, ptr %label_field
  store i32 32, ptr %return_type_field
  ret void
}

; ----------------------------------------------------------------------------
; Text append helpers
; ----------------------------------------------------------------------------

define i32 @weave_emit_cstr(ptr %ctx, ptr %text) {
entry:
  %out = call ptr @weave_emit_out(ptr %ctx)
  %status = call i32 @weave_buffer_append_cstr(ptr %out, ptr %text)
  ret i32 %status
}

define i32 @weave_emit_byte(ptr %ctx, i32 %byte) {
entry:
  %out = call ptr @weave_emit_out(ptr %ctx)
  %status = call i32 @weave_buffer_append_byte(ptr %out, i32 %byte)
  ret i32 %status
}

define i32 @weave_emit_i32(ptr %ctx, i32 %value) {
entry:
  %out = call ptr @weave_emit_out(ptr %ctx)
  %status = call i32 @weave_buffer_append_i32(ptr %out, i32 %value)
  ret i32 %status
}

define i32 @weave_emit_newline(ptr %ctx) {
entry:
  %status = call i32 @weave_emit_byte(ptr %ctx, i32 10)
  ret i32 %status
}

