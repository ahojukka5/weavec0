; 102_const_i64_min.wir
; purpose: covers the smallest representable i64 literal (INT64_MIN).
; verifies -9223372036854775808 is emitted exactly and truncates to i32 zero.
; expected runtime behavior: process exits with code 0.

(core-module
  (core-version 2)
  (decls
    (fn main
      (params)
      (returns i32)
      (do
        (return
          (cast_i64_to_i32
            (const_i64 -9223372036854775808)
          ) ;; cast_i64_to_i32
        ) ;; return
      ) ;; do
    ) ;; fn
  ) ;; decls
) ;; core-module
