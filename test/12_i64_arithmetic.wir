; 12_i64_arithmetic.wir
; purpose: validates arithmetic operators over i64 values.
; verifies i64 math results can be consumed by later casts/returns.
; expected runtime behavior: process exits with code 42.

(core-module
  (core-version 2)
  (decls
    (fn main
      (params)
      (returns i32)
      (do
        (let a i64
          (const_i64 20)
        ) ;; let
        (let b i64
          (const_i64 2)
        ) ;; let
        (let c i64
          (mul_i64
            (local_get b)
            (const_i64 11)
          ) ;; mul_i64
        ) ;; let
        (let d i64
          (add_i64
            (local_get a)
            (local_get c)
          ) ;; add_i64
        ) ;; let
        (return
          (cast_i64_to_i32
            (local_get d)
          ) ;; cast_i64_to_i32
        ) ;; return
      ) ;; do
    ) ;; fn
  ) ;; decls
) ;; core-module
