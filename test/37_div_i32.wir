; 37_div_i32.wir
; purpose: validates signed division behavior for i32 values.
; verifies div_i32 emits sdiv and returns the expected quotient.
; expected runtime behavior: process exits with code 42.

(core-module
  (core-version 2)
  (decls
    (fn main
      (params)
      (returns i32)
      (do
        (return
          (div_i32
            (const_i32 126)
            (const_i32 3)
          ) ;; div_i32
        ) ;; return
      ) ;; do
    ) ;; fn
  ) ;; decls
) ;; core-module
