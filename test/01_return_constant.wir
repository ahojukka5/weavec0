; 01_return_constant.wir
; purpose: baseline smoke test for the smallest valid module and function body.
; verifies that returning const_i32 0 is parsed, lowered, and executable.
; expected runtime behavior: process exits with code 0.

(core-module
  (core-version 2)
  (decls
    (fn main
      (params)
      (returns i32)
      (do
        (return
          (const_i32 0)
        ) ;; return
      ) ;; do
    ) ;; fn
  ) ;; decls
) ;; core-module
