; 11_const_i64.wir
; purpose: introduces 64-bit constants into the bootstrap subset.
; verifies const_i64 plus cast_i64_to_i32 round-trip in return position.
; expected runtime behavior: process exits with code 42.

(core-module
  (core-version 2)
  (decls
    (fn main
      (params)
      (returns i32)
      (do
        (let x i64
          (const_i64 42)
        ) ;; let
        (return
          (cast_i64_to_i32
            (local_get x)
          ) ;; cast_i64_to_i32
        ) ;; return
      ) ;; do
    ) ;; fn
  ) ;; decls
) ;; core-module
