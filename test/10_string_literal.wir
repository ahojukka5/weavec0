; 10_string_literal.wir
; purpose: checks string literal tokenization and emission path.
; verifies const_string_ptr handling through the required puts call path.
; expected runtime behavior: process exits with code 42.

(core-module
  (core-version 1)
  (decls
    (extern puts
      (params
        (text ptr)
      ) ;; params
      (returns i32)
    ) ;; extern

    (fn main
      (params)
      (returns i32)
      (do
        (call_i32 puts
          (const_string_ptr "hello from weave")
        ) ;; call_i32
        (return
          (const_i32 42)
        ) ;; return
      ) ;; do
    ) ;; fn
  ) ;; decls
) ;; core-module
