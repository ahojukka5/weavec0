; 46_forward_function_call.wir
; purpose: validates calling a function before its textual definition.
; verifies declaration ordering and symbol resolution in emitted LLVM IR.
; expected runtime behavior: process exits with code 42.

(core-module
  (core-version 1)
  (decls
    (fn main
      (params)
      (returns i32)
      (do
        (return
          (call_i32 answer)
        ) ;; return
      ) ;; do
    ) ;; fn

    (fn answer
      (params)
      (returns i32)
      (do
        (return
          (const_i32 42)
        ) ;; return
      ) ;; do
    ) ;; fn
  ) ;; decls
) ;; core-module
