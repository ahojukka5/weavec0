; 50_parse_error_smoke.wir
; purpose: baseline negative test for generic parse failure handling.
; verifies malformed input is rejected instead of producing output LLVM IR.
; expected compiler behavior: compilation fails with a parsing diagnostic.

(core-module
  (core-version 2)
  (decls
    (fn main
      (params)
      (returns i32)
      (do
        (return
          (add_i32
            (const_i32 20)
            (const_i32 22)
          ) ;; add_i32
        ) ;; return
      ) ;; do
    ;; ERROR: missing closing parens for fn/decls/core-module
