; 23_mod_i32.wir
; purpose: adds signed remainder coverage for i32 via mod_i32.
; verifies modulo semantics by returning the remainder value directly.
; expected runtime behavior: process exits with code 2.

(core-module
  (core-version 1)
  (decls
    (fn main
      (params)
      (returns i32)
      (do
        (return
          (mod_i32
            (const_i32 42)
            (const_i32 10)
          ) ;; mod_i32
        ) ;; return
      ) ;; do
    ) ;; fn
  ) ;; decls
) ;; core-module
