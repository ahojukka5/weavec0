; 44_while_zero_iterations.wir
; purpose: validates while loops whose condition is false at entry.
; verifies zero-iteration loops skip body execution cleanly.
; expected runtime behavior: process exits with code 42.

(core-module
  (core-version 2)
  (decls
    (fn main
      (params)
      (returns i32)
      (do
        (let i i32
          (const_i32 10)
        ) ;; let

        (let sum i32
          (const_i32 42)
        ) ;; let

        (while
          (condition
            (lt_i32
              (local_get i)
              (const_i32 5)
            ) ;; lt_i32
          ) ;; condition
          (do
            (set sum
              (const_i32 0)
            ) ;; set

            (set i
              (add_i32
                (local_get i)
                (const_i32 1)
              ) ;; add_i32
            ) ;; set
          ) ;; do
        ) ;; while

        (return
          (local_get sum)
        ) ;; return
      ) ;; do
    ) ;; fn
  ) ;; decls
) ;; core-module
