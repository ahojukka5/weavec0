; 29_const_string_ptr.wir
; purpose: checks const_string_ptr generation for pointer-typed string data.
; verifies emitted globals and pointer usage for string addresses.
; expected runtime behavior: process exits with code 42.

(core-module
  (core-version 1)
  (decls
    (extern puts
      (params
        (s ptr)
      ) ;; params
      (returns i32)
    ) ;; extern
    (fn main
      (params)
      (returns i32)
      (do
        (call_i32 puts
          (const_string_ptr "hello from const_string_ptr")
        ) ;; call_i32
        (return
          (const_i32 42)
        ) ;; return
      ) ;; do
    ) ;; fn
  ) ;; decls
) ;; core-module
