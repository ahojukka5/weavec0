; 51_unknown_operator.wir
; purpose: ensures unsupported operators are rejected explicitly.
; verifies parser reports unknown-operator diagnostics on invalid forms.
; expected compiler behavior: compilation fails with an unknown operator diagnostic.

(core-module
  (core-version 2)
  (decls
    (fn main
      (params)
      (returns i32)
      (do
        (return
          (banana_i32
            (const_i32 20)
            (const_i32 22)
          ) ;; banana_i32
        ) ;; return
      ) ;; do
    ) ;; fn
  ) ;; decls
) ;; core-module
