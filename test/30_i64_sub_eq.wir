; 30_i64_sub_eq.wir
; purpose: validates i64 subtraction followed by equality comparison.
; verifies BIN_SUB_I64 and BIN_EQ_I64 lowering in one scenario.
; expected runtime behavior: process exits with code 42.

(core-module
  (core-version 2)
  (decls
    (fn main
      (params)
      (returns i32)
      (do
        (if
          (condition
            (eq_i64
              (sub_i64
                (const_i64 50)
                (const_i64 8)
              ) ;; sub_i64
              (const_i64 42)
            ) ;; eq_i64
          ) ;; condition
          (then
            (do
              (return
                (const_i32 42)
              ) ;; return
            ) ;; do
          ) ;; then
          (else
            (do
              (return
                (const_i32 0)
              ) ;; return
            ) ;; do
          ) ;; else
        ) ;; if
      ) ;; do
    ) ;; fn
  ) ;; decls
) ;; core-module
