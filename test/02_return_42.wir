; 02_return_42.wir
; purpose: confirms non-zero integer literals are preserved end-to-end.
; verifies a direct const_i32 42 return from main.
; expected runtime behavior: process exits with code 42.

(core-module
  (core-version 2)
  (decls
    (fn main
      (params)
      (returns i32)
      (do
        (return
          (const_i32 42)
        ) ;; return
      ) ;; do
    ) ;; fn
  ) ;; decls
) ;; core-module
