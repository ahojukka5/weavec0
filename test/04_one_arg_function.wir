; 04_one_arg_function.wir
; purpose: validates single-parameter function declaration and call wiring.
; verifies argument passing through param_get in a called function.
; expected runtime behavior: process exits with code 42.

(core-module
  (core-version 2)
  (decls
    (fn inc
      (params
        (x i32)
      ) ;; params
      (returns i32)
      (do
        (return
          (add_i32
            (param_get x)
            (const_i32 1)
          ) ;; add_i32
        ) ;; return
      ) ;; do
    ) ;; fn
    (fn main
      (params)
      (returns i32)
      (do
        (return
          (call_i32 inc
            (const_i32 41)
          ) ;; call_i32
        ) ;; return
      ) ;; do
    ) ;; fn
  ) ;; decls
) ;; core-module
