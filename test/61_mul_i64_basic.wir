; 61_mul_i64_basic.wir
; purpose: exercises mul_i64 as the top-level computation in a return.
; verifies signed 64-bit multiplication lowers through cast_i64_to_i32.
; expected runtime behavior: process exits with code 42 (6 * 7).

(core-module
  (core-version 1)
  (decls
    (fn main
      (params)
      (returns i32)
      (do
        (return
          (cast_i64_to_i32
            (mul_i64
              (const_i64 6)
              (const_i64 7)
            ) ;; mul_i64
          ) ;; cast_i64_to_i32
        ) ;; return
      ) ;; do
    ) ;; fn
  ) ;; decls
) ;; core-module
