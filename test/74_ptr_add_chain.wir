; 74_ptr_add_chain.wir
; purpose: chains two ptr_add operations against the same base pointer.
; verifies (ptr_add (ptr_add p o1) o2) materialises both gep temps in order.
; expected runtime behavior: process exits with code 42 (storing 42 at base+16, reading it back).

(core-module
  (core-version 1)
  (decls
    (extern malloc
      (params
        (size i64)
      ) ;; params
      (returns ptr)
    ) ;; extern
    (extern free
      (params
        (p ptr)
      ) ;; params
      (returns void)
    ) ;; extern

    (fn main
      (params)
      (returns i32)
      (do
        (let p ptr
          (call_ptr malloc
            (const_i64 32)
          ) ;; call_ptr
        ) ;; let

        (if
          (condition
            (eq_ptr (local_get p) (const_null))
          ) ;; condition
          (then
            (do (return (const_i32 0)))
          ) ;; then
          (else
            (do)
          ) ;; else
        ) ;; if

        (store_i64
          (ptr_add
            (ptr_add
              (local_get p)
              (const_i64 8)
            ) ;; ptr_add
            (const_i64 8)
          ) ;; ptr_add
          (const_i64 42)
        ) ;; store_i64

        (let v i64
          (load_i64
            (ptr_add
              (ptr_add
                (local_get p)
                (const_i64 8)
              ) ;; ptr_add
              (const_i64 8)
            ) ;; ptr_add
          ) ;; load_i64
        ) ;; let

        (call_void free
          (local_get p)
        ) ;; call_void

        (return
          (cast_i64_to_i32
            (local_get v)
          ) ;; cast_i64_to_i32
        ) ;; return
      ) ;; do
    ) ;; fn
  ) ;; decls
) ;; core-module
