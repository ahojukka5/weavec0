; 96_ptr_arithmetic_zero_offset.wir
; purpose: exercises ptr_add with a zero offset — a degenerate but admitted form.
; verifies the emitter does not special-case offset == 0 (it should emit a
;   plain gep regardless) and that the resulting pointer still round-trips
;   through store/load.
; expected runtime behavior: process exits with code 42.

(core-module
  (core-version 1)
  (decls
    (extern malloc
      (params (size i64))
      (returns ptr)
    ) ;; extern
    (extern free
      (params (p ptr))
      (returns void)
    ) ;; extern

    (fn main
      (params)
      (returns i32)
      (do
        (let p ptr
          (call_ptr malloc (const_i64 8))
        ) ;; let

        (if
          (condition
            (eq_ptr (local_get p) (const_null))
          ) ;; condition
          (then (do (return (const_i32 0)))) ;; then
          (else (do)) ;; else
        ) ;; if

        (store_i64
          (ptr_add
            (local_get p)
            (const_i64 0)
          ) ;; ptr_add — zero offset
          (const_i64 42)
        ) ;; store_i64

        (let v i64
          (load_i64 (local_get p))
        ) ;; let

        (call_void free (local_get p)) ;; call_void

        (return
          (cast_i64_to_i32 (local_get v))
        ) ;; return
      ) ;; do
    ) ;; fn
  ) ;; decls
) ;; core-module
