; 52_wrong_arity_add_i32_too_few.wir
; purpose: validates arity checking for add_i32 with missing arguments.
; verifies parser rejects too-few-argument calls with a clear error.
; expected compiler behavior: compilation fails with an arity diagnostic.

(core-module
  (core-version 1)
  (decls
    (fn main
      (params)
      (returns i32)
      (do
        (return
          (add_i32
            (const_i32 42)
          ) ;; add_i32
        ) ;; return
      ) ;; do
    ) ;; fn
  ) ;; decls
) ;; core-module
