; 19_call_void.wir
; purpose: adds coverage for calling functions that return void.
; verifies call_void statements are emitted without value misuse.
; expected runtime behavior: process exits with code 42.

(core-module
  (core-version 2)
  (decls
    (extern free
      (params
        (p ptr)
      ) ;; params
      (returns void)
    ) ;; extern
    (fn main
      (params)
      (returns i32)
      (do
        (call_void free
          (const_null)
        ) ;; call_void
        (return
          (const_i32 42)
        ) ;; return
      ) ;; do
    ) ;; fn
  ) ;; decls
) ;; core-module
