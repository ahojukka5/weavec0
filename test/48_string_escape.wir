; 48_string_escape.wir
; purpose: validates escaped characters inside string literals.
; verifies emitter escapes bytes correctly for LLVM string constants.
; expected runtime behavior: process exits with code 42.

(core-module
  (core-version 2)
  (decls
    (extern puts
      (params
        (text ptr)
      ) ;; params
      (returns i32)
    ) ;; extern

    (fn main
      (params)
      (returns i32)
      (do
        (call_i32 puts
          (const_string_ptr "hello\nworld")
        ) ;; call_i32

        (call_i32 puts
          (const_string_ptr "quote: \"weave\"")
        ) ;; call_i32

        (call_i32 puts
          (const_string_ptr "backslash: \\")
        ) ;; call_i32

        (return
          (const_i32 42)
        ) ;; return
      ) ;; do
    ) ;; fn
  ) ;; decls
) ;; core-module
